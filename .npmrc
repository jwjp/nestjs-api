# @nestjs/schematics@12 (pulled in by @nestjs/cli) requires typescript >=6.0.0,
# but TypeScript jumped from 5.x straight to 7.x (no 6.x line exists) and
# ts-jest does not yet support typescript 7. Until ts-jest adds typescript 7
# support, this peer conflict cannot be satisfied cleanly.
legacy-peer-deps=true
