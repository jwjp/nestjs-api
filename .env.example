# Copy to envs/.local.env for local development.
# Generate each JWT secret with: openssl rand -hex 32
# NODE_ENV=prod refuses secrets shorter than 32 characters.

PORT=3000
APP_NAME=NestJS API
# Behind one reverse proxy such as Nginx, use 1. Leave empty when clients connect directly.
TRUST_PROXY=
# Comma-separated browser origins. Without a list, prod allows no cross-origin calls.
CORS_ORIGINS=

THROTTLE_TTL_MS=10000
THROTTLE_LIMIT=10
# Per minute, for login, refresh and password endpoints.
AUTH_THROTTLE_LIMIT=10

# Port 3307 is the database from docker-compose.yml
DB_HOST=127.0.0.1
DB_PORT=3307
DB_SCHEMA=api
DB_USERNAME=root
DB_PASSWORD=root
DB_ENTITIES=dist/**/*.entity.js
DB_CHARSET=utf8mb4_unicode_ci
# Apply migrations on startup. Use only with a single instance.
DB_MIGRATIONS_RUN=true

JWT_ACCESS_SECRET_KEY=replace-with-a-random-value
JWT_ACCESS_EXPIRES_TIME=15m
JWT_REFRESH_SECRET_KEY=replace-with-another-random-value
JWT_REFRESH_EXPIRES_TIME=14d
JWT_EMAIL_VALIDATION_SECRET_KEY=replace-with-another-random-value
JWT_EMAIL_VALIDATION_EXPIRES_TIME=30m
JWT_PASSWORD_RESET_SECRET_KEY=replace-with-another-random-value
JWT_PASSWORD_RESET_EXPIRES_TIME=30m

# Origin used in verification email links. Emails are refused while unset.
PUBLIC_BASE_URL=http://localhost:3000
# Frontend page that receives ?token= and calls POST /members/password/reset.
# Reset emails are not sent while unset.
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Receives member removal notifications (optional).
# ADMIN_EMAIL=admin@example.com

SLACK_CHANNEL=replace-me
SLACK_TOKEN=replace-me
SLACK_WEBHOOK=https://hooks.slack.com/services/replace/me/now

EMAIL_USERNAME=sender@example.com
EMAIL_PASSWORD=replace-me

UPLOAD_S3_PATH=files

AWS_ACCESS_KEY=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_BUCKET=replace-me
AWS_S3_REGION=ap-northeast-2

SWAGGER_USERNAME=replace-me
SWAGGER_PASSWORD=replace-me
